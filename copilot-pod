#!/usr/bin/env bash
set -euo pipefail

# ANSI color codes for consistent error formatting
BOLD=$'\e[1m'; RED=$'\e[31m'; RESET=$'\e[0m'
[[ -t 1 ]] || { BOLD=; RED=; RESET=; }
err() { printf '%s✗%s %s\n' "$RED" "$RESET" "$*" >&2; }
die() { err "$*"; exit 1; }

# --help / -h: print copy-pastable usage and exit BEFORE any Docker work, so help still works when
# Docker is down or the image isn't built yet. We resolve our own location so every command printed
# below is copy-pastable as-is — no matter where the repo was cloned or whether the alias is set up.
if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  row() { printf '  %-18s %s%s%s\n' "$1" "$BOLD" "$2" "$RESET"; }
  printf '%scopilot-pod%s — run Copilot CLI in a Docker sandbox scoped to the current folder.\n' "$BOLD" "$RESET"
  printf '\n%sRun%s  (cd into your project first — the current folder is what gets mounted):\n' "$BOLD" "$RESET"
  row "Open a shell:"   "$HERE/copilot-pod"
  row "Run Copilot:"     "$HERE/copilot-pod copilot --yolo"
  printf '\n%sManage%s  (works from any folder):\n' "$BOLD" "$RESET"
  row "Install/update:" "$HERE/install.sh"
  row "Pin a version:"  "COPILOT_CLI_VERSION=2.0.0 $HERE/install.sh"
  row "Uninstall:"      "$HERE/uninstall.sh"
  printf '\n%sOptions%s  (prefix any run command):\n' "$BOLD" "$RESET"
  row "Publish ports:"  "PORTS=\"3000 5173\" $HERE/copilot-pod"
  row "Isolate/limit:"  "NET=none MEMORY=4g PIDS=512 $HERE/copilot-pod"
  row "Docker access:"  "DOCKER=1 $HERE/copilot-pod"
  row "Keep Docker cache:" "DOCKER=1 DOCKER_CACHE=1 $HERE/copilot-pod"
  printf '\n'
  row "Shortcut alias:" "alias copilot-pod=$HERE/copilot-pod"
  row "Full README:"    "https://github.com/alfsch/copilot-pod"
  exit 0
fi

# Preflight checks, in causal order. Without these the failures surface as cryptic Docker errors:
#   - daemon down -> the image check below would falsely blame a missing image.
#   - missing image -> Docker would try to pull 'copilot-pod' from Docker Hub and fail.
# We probe existence with `image ls -q`, not `image inspect`: it resolves the name the same way
# `docker run` does, so the check can't disagree with whether the run will actually work. (Some
# Docker Desktop builds have a broken `image inspect <name>` that false-negatives on a present
# image, which would otherwise wrongly send you to re-run install.sh.)
command -v docker >/dev/null || die "Docker is required but not on PATH."
docker info >/dev/null 2>&1 || die "Docker daemon is not running."
if [ -z "$(docker image ls -q copilot-pod 2>/dev/null)" ]; then
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  err "Image 'copilot-pod' not found."
  die "Please run '${BOLD}${SCRIPT_DIR}/install.sh${RESET}' first to build the local container."
fi

# Auto-update on every start: if the image was built from the "latest" channel (label set by
# install.sh) and npm's current latest differs from what's installed, rebuild via install.sh before
# launching. Images pinned to a version are left alone, as are images built before
# the labels existed (re-run install.sh once to opt in). The check is best-effort: a slow/offline
# registry (3s cap) or a failed rebuild only prints a note and continues with the existing image.
# Set COPILOT_POD_NO_UPDATE=1 to skip it. Output goes to stderr so piped stdout stays clean.
if [ -z "${COPILOT_POD_NO_UPDATE:-}" ] && command -v curl >/dev/null; then
  # Inspect by image ID (found via `image ls -q`, like the preflight above), not by name — see the
  # Docker Desktop note there. A failed lookup leaves the labels empty, which just skips the update.
  _image_id="$(docker image ls -q copilot-pod:latest 2>/dev/null | head -n1 || true)"
  _label() { [ -n "$_image_id" ] && docker image inspect --format "{{index .Config.Labels \"$1\"}}" "$_image_id" 2>/dev/null || true; }
  if [ "$(_label copilot-pod.channel)" = "latest" ]; then
    _installed="$(_label copilot-pod.version)"
    # If install.sh couldn't resolve "latest" at build time, the label holds the literal tag; ask the
    # image for the real version so an up-to-date image isn't needlessly rebuilt.
    if [[ ! "$_installed" =~ ^[0-9] ]]; then
      _installed="$(docker run --rm copilot-pod copilot --version 2>/dev/null | sed -n 's/^\([0-9][0-9.]*\).*/\1/p' || true)"
    fi
    _latest="$(curl -fsSL --max-time 3 https://registry.npmjs.org/-/package/@github/copilot/dist-tags 2>/dev/null \
      | sed -n 's/.*"latest"[[:space:]]*:[[:space:]]*"\([0-9][^"]*\)".*/\1/p' || true)"
    if [ -n "$_latest" ] && [ "$_latest" != "$_installed" ]; then
      printf '%s●%s New Copilot CLI %s (installed: %s) — updating image...\n' "$BOLD" "$RESET" "$_latest" "${_installed:-unknown}" >&2
      # Force latest: an exported COPILOT_CLI_VERSION must not turn this into a pinned image.
      COPILOT_CLI_VERSION=latest "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/install.sh" >&2 \
        || err "Update failed; continuing with the existing image."
    fi
  fi
fi

# Host-side state dir: persists Copilot's auth + history across container restarts.
mkdir -p "$HOME/.copilot-pod"

# Copilot reads its main config from $HOME/.copilot.json (a file at HOME, sibling to the .copilot/
# directory). We bind-mount this file separately so login state survives. Two quirks:
#   - Docker creates a directory at the target if the source path is missing, so the file must
#     pre-exist on the host before `docker run`.
#   - Copilot treats an empty file as a JSON parse error, not as "no config", so we seed it with {}.
[ -s "$HOME/.copilot-pod/.copilot.json" ] || printf '{}' > "$HOME/.copilot-pod/.copilot.json"

# Restrict to owner-only. The directory holds the Copilot/GitHub auth token and session transcripts
# (which can contain code, file contents, and command output Copilot saw); on multi-user hosts the
# default 755/644 modes would let other local users read both. Matches the convention used for
# ~/.ssh, ~/.aws, ~/.gnupg.
chmod 700 "$HOME/.copilot-pod"
chmod 600 "$HOME/.copilot-pod/.copilot.json"

# Mounts & Users:
#   --user -> dynamic                            Runs container exactly as the host user to prevent permission issues.
#   HOME=/home/copilot-pod                        Because user is dynamic, we use a dedicated writable home dir.
#   $PWD -> $PWD                                 project files; same path on both sides keeps file
#                                                references (logs, errors, tool output) consistent
#                                                between host and container.
#   ~/.copilot-pod -> /home/copilot-pod/.copilot    credentials, sessions, history (the .copilot dir).
#   ~/.copilot-pod/.copilot.json -> ditto          account binding + project trust state (sibling file).
# TTY Detection:
#   If we pipe data into the script (e.g. `cat file | copilot-pod`), input is not a terminal.
#   Passing `-t` to Docker in this case would cause a crash.
#   [ -t 0 ] checks if STDIN is a terminal. If yes, keep it interactive (-i).
#   [ -t 1 ] checks if STDOUT is a terminal. If yes, allocate a pseudo-TTY (-t).
DOCKER_FLAGS=("--rm")
[ -t 0 ] && DOCKER_FLAGS+=("-i")
[ -t 1 ] && DOCKER_FLAGS+=("-t")

# Optional Port Mapping:
#   Allows users to map dev servers by passing PORTS="3000 8080:80".
#   We force binding to 127.0.0.1 to prevent exposing dev servers to public networks.
#   Each entry must be either "PORT" or "HOST:CONTAINER", with both parts in the 1-65535 range.
#   We validate up front so a typo surfaces as a clear error here rather than a cryptic Docker failure.
if [ -n "${PORTS:-}" ]; then
  for port in $PORTS; do
    if [[ ! "$port" =~ ^[0-9]+(:[0-9]+)?$ ]]; then
      die "PORTS entry '$port' is invalid; expected 'PORT' or 'HOST:CONTAINER' (digits only)."
    fi
    # Range-check each numeric component. 10# forces base-10 so "08"/"09" don't parse as octal.
    IFS=':' read -ra _port_parts <<< "$port"
    for _n in "${_port_parts[@]}"; do
      if (( 10#$_n < 1 || 10#$_n > 65535 )); then
        die "PORTS entry '$port' has '$_n' outside the 1-65535 range."
      fi
    done
    if [[ "$port" == *":"* ]]; then
      DOCKER_FLAGS+=("-p" "127.0.0.1:${port}")
    else
      DOCKER_FLAGS+=("-p" "127.0.0.1:${port}:${port}")
    fi
  done
fi

# Optional Network Isolation:
#   By default the container has unrestricted outbound networking — Copilot needs GitHub's Copilot API
#   (api.github.com, api.githubcopilot.com), and your builds need the npm/pip/etc. registries. Set NET=none to cut ALL networking for the run.
#   Use this to inspect or build code from an untrusted source offline: with no network, a malicious
#   payload can't exfiltrate the project or phone home. Note that Copilot itself can't reach GitHub
#   in this mode, so it's for sandboxed shell/build work, not for a live Copilot session.
#   NET=none and PORTS are mutually exclusive — you can't publish a port on a container with no network.
if [ "${NET:-}" = "none" ]; then
  [ -n "${PORTS:-}" ] && die "NET=none and PORTS are mutually exclusive: a no-network container can't publish ports."
  DOCKER_FLAGS+=("--network=none")
fi

# Resource Limits (host availability):
#   Dropping capabilities does NOT stop fork() or memory allocation, so a runaway or malicious
#   process inside the container can still fork-bomb or exhaust memory and drag the host down.
#   --pids-limit caps total processes/threads. The default is generous enough for normal builds;
#     raise it with PIDS= for very parallel builds, or lower it when running untrusted code.
#   MEMORY/CPUS are opt-in with no default on purpose: a fixed memory cap would OOM-kill legitimate
#     large builds, and the right ceiling depends on your host's RAM. Set e.g. MEMORY=4g CPUS=2
#     when running code you don't trust.
DOCKER_FLAGS+=("--pids-limit=${PIDS:-4096}")
[ -n "${MEMORY:-}" ] && DOCKER_FLAGS+=("--memory=$MEMORY")
[ -n "${CPUS:-}" ]   && DOCKER_FLAGS+=("--cpus=$CPUS")

# Optional Docker access (DOCKER=1):
#   Gives the session its own throwaway Docker daemon without weakening this container. A separate
#   rootless Docker-in-Docker sidecar runs on a private per-run network; only it gets --privileged
#   (rootless dockerd needs user namespaces, which the hardening above forbids). This container keeps
#   every restriction and only gets the docker CLI pointing at the sidecar via DOCKER_HOST. It never
#   touches the host's Docker socket, and works the same on Linux, macOS and Windows (WSL2).
#   - The daemon requires mutual TLS (port 2376). The sidecar generates the certificates into a
#     per-run volume that only it and this pod mount, so other containers and local host users that
#     can reach the sidecar's bridge IP can't use the daemon. The port is never published.
#   - $PWD is mounted into the sidecar at the same path so `docker run -v "$PWD:..."` resolves. The
#     sidecar user is uid 1000, so on hosts where your uid differs, inner containers may not be able
#     to write to the project.
#   - Images, containers and volumes of the inner daemon vanish when the session ends, unless
#     DOCKER_CACHE=1: then the daemon's data dir lives in a named volume (copilot-pod-docker-<hash of
#     $PWD>, one per project) and image layers are reused across sessions. A named volume, not a host
#     folder, because overlay storage doesn't work on macOS/Windows file shares and the dir must be
#     owned by the sidecar's uid 1000. Only one session per project may use it at a time, since two
#     dockerd instances can't share a data dir. Trade-off: whatever a session pulled or built (including
#     anything malicious or secret) is still there next time; uninstall.sh removes these volumes.
#   - Ports published by inner containers live on the sidecar's network, not on the host.
#   The sidecar image is pinned by digest (kept current by Renovate). Override it with DIND_IMAGE=...
DIND_IMAGE="${DIND_IMAGE:-docker:28-dind-rootless@sha256:7c3e797187e43738220462658f4586572cbd3bf009f728b21e34d9c5c06ce431}"
# Host-side state for DOCKER_CACHE (usage stamps, per-cache reservations). Deliberately outside
# ~/.copilot-pod: that dir is mounted into the pod, so a session could edit a file there and keep (or
# prematurely drop) its cache.
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/copilot-pod"
HELD_LOCKS=()
# Cross-process lock via an atomic mkdir (flock isn't available on macOS). The owner's PID is stored
# inside, so a lock left behind by a killed launcher can be reclaimed. Reclaiming is itself serialized
# by a second mkdir lock ("<dir>.reclaim", held for milliseconds, treated as abandoned after a
# minute), and the owner is re-read under it. Only a reclaimer can remove a lock it didn't create, so
# it can never delete a lock that someone acquired after the dead owner's. Waits up to $2 seconds.
# Held locks are released by cleanup_dind on exit; acquiring a lock this process already holds succeeds.
lock_reclaim_stale() {
  local dir="$1" pid
  if ! mkdir "$dir.reclaim" 2>/dev/null; then
    [ -z "$(find "$dir.reclaim" -maxdepth 0 -mmin +1 2>/dev/null)" ] || rm -rf "$dir.reclaim"
    return 0
  fi
  pid="$(cat "$dir/pid" 2>/dev/null || true)"
  if [ -n "$pid" ]; then
    kill -0 "$pid" 2>/dev/null || rm -rf "$dir"
  elif [ -n "$(find "$dir" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then
    rm -rf "$dir"   # owner died between mkdir and writing its PID
  fi
  rmdir "$dir.reclaim"
}
lock_acquire() {
  local dir="$1" max_wait="$2" waited=0
  mkdir -p "$(dirname "$dir")"
  while ! mkdir "$dir" 2>/dev/null; do
    [ "$(cat "$dir/pid" 2>/dev/null || true)" != "$$" ] || return 0
    lock_reclaim_stale "$dir"
    mkdir "$dir" 2>/dev/null && break
    if [ "$waited" -ge "$max_wait" ]; then return 1; fi
    sleep 1; waited=$(( waited + 1 ))
  done
  printf '%s' "$$" > "$dir/pid"
  HELD_LOCKS+=("$dir")
}
lock_release() {
  local dir="$1" held keep=()
  rm -rf "$dir"
  for held in ${HELD_LOCKS[@]+"${HELD_LOCKS[@]}"}; do [ "$held" = "$dir" ] || keep+=("$held"); done
  HELD_LOCKS=(${keep[@]+"${keep[@]}"})
}
# Only volumes this launcher generates: --filter name= matches substrings, which would also catch
# unrelated volumes like "backup-copilot-pod-docker-123".
list_dind_caches() { docker volume ls -q --filter name=copilot-pod-docker- 2>/dev/null | grep -E '^copilot-pod-docker-[0-9]+$' || true; }
# Housekeeping for DOCKER_CACHE volumes: Docker doesn't record when a volume was last used, so each
# DOCKER_CACHE start stamps the current project's volume in a state file, and
# volumes untouched for DOCKER_CACHE_MAX_AGE_DAYS (default 90, 0 disables deleting) are removed on the
# next start. Stamping always happens, even with 0, so a later start with pruning enabled sees the real
# last use. Volumes with no stamp yet (e.g. created before this existed) start their clock now, and a
# volume still attached to a running session can't be removed, so it is kept. The whole
# read/prune/write runs under a lock shared by all launches, and the file is replaced atomically.
prune_dind_caches() {
  local cur="$1" max_days="${DOCKER_CACHE_MAX_AGE_DAYS:-90}" file="$STATE_DIR/docker-cache-usage"
  [[ "$max_days" =~ ^[0-9]+$ ]] || die "DOCKER_CACHE_MAX_AGE_DAYS must be a number of days (0 disables)."
  local now max existing tmp out name ts
  now="$(date +%s)"; max=$(( max_days * 86400 ))
  lock_acquire "$STATE_DIR/usage.lock" 30 || die "Could not lock $STATE_DIR/usage.lock (held by another copilot-pod start)."
  existing="$(list_dind_caches)"
  touch "$file"; tmp="$(mktemp "$file.XXXXXX")"; out="$(mktemp "$file.XXXXXX")"
  while read -r name ts; do
    [ -n "$name" ] || continue
    grep -qxF -- "$name" <<<"$existing" || continue
    [[ "$ts" =~ ^[0-9]+$ ]] || ts="$now"
    if [ "$max_days" -gt 0 ] && [ "$name" != "$cur" ] && (( now - ts > max )); then
      if docker volume rm "$name" >/dev/null 2>&1; then
        printf '%s●%s Removed Docker cache %s (unused for over %s days)\n' "$BOLD" "$RESET" "$name" "$max_days" >&2
        existing="$(grep -vxF -- "$name" <<<"$existing" || true)"
        continue
      fi
    fi
    printf '%s %s\n' "$name" "$ts" >> "$tmp"
  done < "$file"
  for name in $existing; do
    grep -q "^$name " "$tmp" || printf '%s %s\n' "$name" "$now" >> "$tmp"
  done
  { grep -v "^$cur " "$tmp" || true; printf '%s %s\n' "$cur" "$now"; } > "$out"
  mv -f "$out" "$file"
  rm -f "$tmp"
  lock_release "$STATE_DIR/usage.lock"
}
# Stamp a cache's last use (also done at shutdown: a session may outlive the age limit).
stamp_dind_cache() {
  local cur="$1" file="$STATE_DIR/docker-cache-usage" tmp
  mkdir -p "$STATE_DIR"; touch "$file"; tmp="$(mktemp "$file.XXXXXX")"
  { grep -v "^$cur " "$file" || true; printf '%s %s\n' "$cur" "$(date +%s)"; } > "$tmp"
  mv -f "$tmp" "$file"
}
cleanup_dind() {
  local held
  # With a cache, take the usage lock before removing the sidecar and keep it until the stamp is
  # written, so no other launcher can prune this cache in between. If the lock can't be had, still clean up.
  [ -z "${DIND_CACHE_VOL:-}" ] || lock_acquire "$STATE_DIR/usage.lock" 30 || true
  docker rm -f "$DIND_NAME" >/dev/null 2>&1 || true
  [ -z "${DIND_CACHE_VOL:-}" ] || stamp_dind_cache "$DIND_CACHE_VOL" 2>/dev/null || true
  docker network rm "$DIND_NET" >/dev/null 2>&1 || true
  docker volume rm "$DIND_CERTS" >/dev/null 2>&1 || true
  for held in ${HELD_LOCKS[@]+"${HELD_LOCKS[@]}"}; do rm -rf "$held"; done
}
[ -n "${DOCKER_CACHE:-}" ] && [ -z "${DOCKER:-}" ] && die "DOCKER_CACHE=1 only works together with DOCKER=1."
if [ -n "${DOCKER:-}" ]; then
  [ "${NET:-}" = "none" ] && die "DOCKER=1 and NET=none are mutually exclusive: the pod needs a network to reach its Docker daemon."
  DIND_NAME="copilot-pod-dind-$$"
  DIND_NET="copilot-pod-net-$$"
  DIND_CERTS="copilot-pod-certs-$$"
  trap cleanup_dind EXIT
  docker network create "$DIND_NET" >/dev/null || die "Could not create network for the Docker sidecar."
  docker volume create "$DIND_CERTS" >/dev/null || die "Could not create certificate volume for the Docker sidecar."
  DIND_DATA_FLAGS=()
  if [ -n "${DOCKER_CACHE:-}" ]; then
    # cksum is POSIX, so this hashes the same way on Linux and macOS.
    _hash="$(printf '%s' "$PWD" | cksum | cut -d' ' -f1)"
    DIND_CACHE_VOL="copilot-pod-docker-$_hash"
    # Reserve the cache atomically (held until this launcher exits, i.e. after its sidecar is gone), so
    # two simultaneous starts can't both pass the check and run dockerd on the same data dir. The
    # docker ps check still catches sessions from a launcher without reservations.
    lock_acquire "$STATE_DIR/cache-$_hash.lock" 0 \
      || die "The Docker cache for this project is in use by another session. Close it or run without DOCKER_CACHE=1."
    if [ -n "$(docker ps -q --filter "volume=$DIND_CACHE_VOL" 2>/dev/null)" ]; then
      die "The Docker cache for this project is in use by another session. Close it or run without DOCKER_CACHE=1."
    fi
    prune_dind_caches "$DIND_CACHE_VOL"
    DIND_CACHE_REUSED=
    list_dind_caches | grep -qxF -- "$DIND_CACHE_VOL" && DIND_CACHE_REUSED=1
    DIND_DATA_FLAGS=(-v "$DIND_CACHE_VOL:/home/rootless/.local/share/docker")
  fi
  docker run -d --rm --privileged \
    --name "$DIND_NAME" --network "$DIND_NET" --network-alias dind \
    --pids-limit="${PIDS:-4096}" \
    ${MEMORY:+--memory="$MEMORY"} ${CPUS:+--cpus="$CPUS"} \
    -e DOCKER_TLS_CERTDIR=/certs \
    -e DOCKER_TLS_SAN=DNS:dind \
    -v "$DIND_CERTS:/certs" \
    ${DIND_DATA_FLAGS[@]+"${DIND_DATA_FLAGS[@]}"} \
    -v "$PWD:$PWD" \
    "$DIND_IMAGE" >/dev/null || die "Could not start the Docker sidecar ($DIND_IMAGE)."
  printf '%s●%s Starting Docker sidecar...\n' "$BOLD" "$RESET" >&2
  for _i in $(seq 1 60); do
    docker exec -e DOCKER_HOST=tcp://localhost:2376 -e DOCKER_TLS_VERIFY=1 -e DOCKER_CERT_PATH=/certs/client \
      "$DIND_NAME" docker info >/dev/null 2>&1 && break
    [ "$_i" = 60 ] && { docker logs "$DIND_NAME" 2>&1 | tail -n 20 >&2; die "Docker sidecar did not become ready."; }
    sleep 1
  done
  if [ -n "${DOCKER_CACHE:-}" ]; then
    if [ -n "$DIND_CACHE_REUSED" ]; then
      # "Images|<count>|<size>" from the sidecar's own daemon
      _stats="$(docker exec -e DOCKER_HOST=tcp://localhost:2376 -e DOCKER_TLS_VERIFY=1 -e DOCKER_CERT_PATH=/certs/client \
        "$DIND_NAME" docker system df --format '{{.Type}}|{{.TotalCount}}|{{.Size}}' 2>/dev/null \
        | sed -n 's/^Images|\([0-9]*\)|\(.*\)$/\1 images, \2/p' || true)"
      printf '%s●%s Docker cache: reusing %s%s\n' "$BOLD" "$RESET" "$DIND_CACHE_VOL" "${_stats:+ ($_stats)}" >&2
    else
      printf '%s●%s Docker cache: created new %s (empty, filled during this session)\n' "$BOLD" "$RESET" "$DIND_CACHE_VOL" >&2
    fi
  fi
  DOCKER_FLAGS+=("--network=$DIND_NET" "-v" "$DIND_CERTS:/certs:ro" \
    "-e" "DOCKER_HOST=tcp://dind:2376" "-e" "DOCKER_TLS_VERIFY=1" "-e" "DOCKER_CERT_PATH=/certs/client")
fi

# Hardening:
#   --cap-drop=ALL                       Drop all Linux capabilities. An interactive dev shell
#                                        as an unprivileged user needs none; this closes off
#                                        capability-based escalation paths (CAP_NET_RAW, etc.)
#                                        and shrinks the surface for known container-escape CVEs.
#   --security-opt=no-new-privileges     Set NO_NEW_PRIVS on the process tree. Even if a setuid
#                                        binary in the image (passwd, su, mount, ...) ever has
#                                        a local-root vulnerability, it cannot elevate.
#
# COLORTERM is forwarded so Copilot CLI's TUI can emit full 24-bit color when the host terminal
# supports it. Bare `-e COLORTERM` (no value) passes the host's setting through — "truecolor" on
# iTerm2, VS Code, WezTerm, etc., or nothing when the host doesn't advertise it, so a non-truecolor
# terminal is never forced into colors it can't render. Without this, docker leaves the container at
# TERM=xterm with no COLORTERM and supports-color downshifts the whole UI to 16 colors.
#
# COPILOT_AUTO_UPDATE=false turns off Copilot CLI's built-in self-updater. Inside the container it can't
# work (the unprivileged runtime user has no write access to the root-owned npm prefix, so it only prints
# "Auto-update failed"), and updates are handled by rebuilding the image instead: the start-up check
# above for the latest channel, or install.sh for a pinned version.
#
# COPILOT_GITHUB_TOKEN / GH_TOKEN / GITHUB_TOKEN are forwarded only when set on the host (bare -e),
# for token-based login instead of the interactive /login. They take precedence over stored
# credentials, and they also authenticate `gh` inside the container.
POD_NAME="copilot-pod-run-$$"
RUN_CMD=(docker run "${DOCKER_FLAGS[@]}" \
  ${DOCKER:+--name "$POD_NAME"} \
  --cap-drop=ALL \
  --security-opt=no-new-privileges \
  --user "$(id -u):$(id -g)" \
  -e HOME=/home/copilot-pod \
  -e COLORTERM \
  -e COPILOT_AUTO_UPDATE=false \
  -e COPILOT_GITHUB_TOKEN \
  -e GH_TOKEN \
  -e GITHUB_TOKEN \
  -v "$PWD:$PWD" \
  -w "$PWD" \
  -v "$HOME/.copilot-pod:/home/copilot-pod/.copilot" \
  -v "$HOME/.copilot-pod/.copilot.json:/home/copilot-pod/.copilot.json" \
  copilot-pod "$@")

# Without the sidecar, exec so signals and the exit code pass straight through. With it we must stay
# alive to remove the sidecar and network on exit, so run the pod in the background (stdin handed over
# explicitly, since a non-interactive shell would otherwise give it /dev/null) and wait for it. On
# SIGTERM/SIGINT/SIGHUP the pod container is stopped first, so the cleanup afterwards isn't racing a
# pod that still uses the network and certificate volume; the pod's own exit code is kept.
if [ -z "${DOCKER:-}" ]; then
  exec "${RUN_CMD[@]}"
fi
stop_pod() { SIG_SEEN=1; docker stop -t 10 "$POD_NAME" >/dev/null 2>&1 || docker rm -f "$POD_NAME" >/dev/null 2>&1 || true; }
trap stop_pod TERM INT HUP
set +e
"${RUN_CMD[@]}" <&0 &
POD_PID=$!
# A trapped signal interrupts `wait` with 128+N without reaping the pod, so keep waiting. If the pod
# exited meanwhile, a second wait collects its real status (127 means the first one already had it).
while :; do
  SIG_SEEN=
  wait "$POD_PID"; rc=$?
  [ -n "$SIG_SEEN" ] && [ "$rc" -gt 128 ] || break
  kill -0 "$POD_PID" 2>/dev/null && continue
  wait "$POD_PID"; _rc2=$?
  [ "$_rc2" -eq 127 ] || rc="$_rc2"
  break
done
exit "$rc"
