{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "forkProcessing": "enabled",
  "customManagers": [
    {
      "description": "Keep the node base image literal in uninstall.sh and the README in sync with the Dockerfile",
      "customType": "regex",
      "managerFilePatterns": ["/^uninstall\\.sh$/", "/^README\\.md$/"],
      "matchStrings": ["node:(?<currentValue>\\d[\\w.]*-slim)"],
      "depNameTemplate": "node",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "description": "Keep the digest-pinned DIND sidecar image literal in the launcher current",
      "customType": "regex",
      "managerFilePatterns": ["/^copilot-pod$/"],
      "matchStrings": ["(?<depName>docker):(?<currentValue>[\\w.-]+)@(?<currentDigest>sha256:[a-f0-9]{64})"],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Bump the node base image everywhere in one PR",
      "matchDepNames": ["node"],
      "matchDatasources": ["docker"],
      "groupName": "node base image"
    },
    {
      "description": "Pin yq's image digest (the Dockerfile COPYs the binary out of it); Renovate updates tag and digest together",
      "matchDepNames": ["mikefarah/yq"],
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": "Pin the digests of the docker CLI and DIND sidecar images",
      "matchDepNames": ["docker"],
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": "Merge GitHub Actions updates once the required stub-tests check passes; main only accepts squash merges",
      "matchManagers": ["github-actions"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    }
  ]
}
